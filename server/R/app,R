library(shiny)
library(ggplot2)
library(tidyr)

# UI定義
ui <- fluidPage(
  titlePanel("リアルタイム最適化モニタリング"),
  plotOutput("paramPlot", height = "600px")
)

# サーバーロジック定義
server <- function(input, output, session) {

  # ログファイルを1秒ごとに監視し、変更があれば読み込む
  logData <- reactiveFileReader(
    intervalMillis = 1000,
    session = session,
    filePath = "optimization_log.csv",
    readFunc = read.csv
  )

  # プロットの描画
  output$paramPlot <- renderPlot({
    df <- logData()
    
    # ggplotでの描画に適したロング形式にデータを変換
    df_long <- tidyr::pivot_longer(
      df,
      cols = -c(iter, objf),
      names_to = "parameter",
      values_to = "value"
    )
    
    # 描画
    ggplot(df_long, aes(x = iter, y = value)) +
      geom_line(color = "blue") +
      geom_point(color = "blue") +
      facet_wrap(~ parameter, scales = "free_y") +
      labs(
        title = paste("パラメータの推移 (最新イテレーション:", max(df$iter), ")"),
        x = "Iteration",
        y = "パラメータ値（無制約スケール）"
      ) +
      theme_bw(base_size = 14)
  })
}

# アプリの起動
shinyApp(ui = ui, server = server)